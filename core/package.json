{
  "name": "ai-l10n-core",
  "version": "1.11.0",
  "description": "Platform-independent core for AI-powered localization — translation API client, language utilities, and shared types",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/esm/index.d.ts",
        "require": "./dist/cjs/index.d.ts"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-type-markers.js",
    "prepare": "npm run build",
    "test": "mocha",
    "verify": "node scripts/verify.js"
  },
  "keywords": [
    "localization",
    "l10n",
    "i18n",
    "translation",
    "ai",
    "sdk",
    "api",
    "typescript",
    "core"
  ],
  "author": "l10n.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/l10n-dev/ai-l10n.git",
    "directory": "core"
  },
  "homepage": "https://github.com/l10n-dev/ai-l10n#readme",
  "bugs": {
    "url": "https://github.com/l10n-dev/ai-l10n/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.10",
    "@types/sinon": "^17.0.3",
    "mocha": "^11.0.1",
    "sinon": "^19.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}